{
  "name": "student-management-system",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npm run frontend\"",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend-react run dev",
    "build": "npm --prefix frontend-react run build",
    "lint": "npm --prefix frontend-react run lint",
    "backend:start": "npm --prefix backend start",
    "migrate:student-ids": "npm --prefix backend run migrate:student-ids",
    "test:backend": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration",
    "ci": "npm run test:backend && npm run build && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
