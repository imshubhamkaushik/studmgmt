# Copy to .env for Docker Compose or configure these values in your secret manager.
JWT_SECRET=replace-with-a-strong-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# Public API URL embedded into the frontend bundle at build time.
# It must be reachable from users' browsers and include /api/v1.
VITE_API_BASE_URL=https://api.students.example.com/api/v1
# Public URL of the frontend, used by the backend CORS policy.
CORS_ORIGINS=https://students.example.com
# Only expose MongoDB outside Docker when intentionally required.
MONGO_ROOT_USERNAME=studmgmt_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-mongodb-password
