# Copy to .env next to docker-compose.prod.yaml and replace every placeholder.
# Never commit the real .env.

# Auth
JWT_SECRET=replace-with-a-strong-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# First administrator, created on backend start-up
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters

# MongoDB root account used by the bundled database container
MONGO_ROOT_USERNAME=studmgmt_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-mongodb-password

# Optional
# RATE_LIMIT_MAX=120
# TRUST_PROXY_HOPS=1    # 2 if a load balancer sits in front of the web container
