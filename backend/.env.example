NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/studDB
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication (use a random secret of at least 32 characters)
JWT_SECRET=svfmhSAWW6kcsgGiSSz1eOoQDK1ku6+crVQPJHo+XmZxFoj7ujud7ImW4+e3RFW8
JWT_ACCESS_TTL_SECONDS=900
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=adminadminadmin

JWT_REFRESH_TTL_DAYS=7
# In production use HTTPS; refresh cookie becomes Secure automatically.

# Student/guardian portal auth reuses JWT_SECRET above (tokens are
# distinguished by an actorType claim, not a separate secret) but has its
# own TTLs, defaulting to the same values as staff auth if unset.
PORTAL_ACCESS_TTL_SECONDS=900
PORTAL_REFRESH_TTL_DAYS=7

# Optional in single-instance development; required for shared production rate limiting
REDIS_URL=redis://localhost:6379/0

# S3 bucket used for portal assignment-submission uploads (presigned POST)
# and for teacher assignment attachments (uploaded via the backend, then
# forwarded to S3). Both can point at the same bucket, under "submissions/"
# and "assignments/" prefixes respectively — see terraform/assignment-
# submissions.tf for the IAM policy that scopes the backend to just those
# two prefixes. Leave unset in local development if you're not exercising
# either upload flow; everything else works without it.
SUBMISSIONS_BUCKET=
ASSIGNMENTS_BUCKET=
