{
  "name": "studmgmt-backend",
  "version": "2.0",
  "description": "Student Management System REST API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --watch-preserve-output src/server.js",
    "migrate:student-ids": "node src/scripts/migrate-student-ids.js",
    "test": "node --test test/*.test.js",
    "migrate:student-statuses": "node src/scripts/migrate-student-statuses.js",
    "migrate:student-portal-credentials": "node src/scripts/migrate-student-portal-credentials.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "keywords": [
    "student-management",
    "express",
    "mongodb",
    "rest-api"
  ],
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "zod": "^3.25.76"
  }
}
