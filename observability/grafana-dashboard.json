{
  "_comment": "Import via the AMG console (Dashboards → New → Import), not Terraform — AMG dashboard provisioning needs the separate grafana/grafana Terraform provider authenticated with a workspace API key, which is its own setup step not included here. This file is still 'dashboard as code' in the sense that matters: versioned, reviewable, reproducible — just applied by hand rather than by `terraform apply`.",
  "title": "studmgmt — unified overview",
  "description": "One dashboard, two data sources (AWS Managed Prometheus for EKS, CloudWatch for Lambda) — the point of unified observability isn't a single vendor, it's not having to context-switch between two consoles to see one request's full path.",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Backend request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${AMP_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_duration_count{service_name=\"studmgmt-backend\"}[5m])) by (http_route)" }
      ]
    },
    {
      "title": "Backend request duration (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${AMP_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_bucket{service_name=\"studmgmt-backend\"}[5m])) by (le, http_route))" }
      ]
    },
    {
      "title": "Lambda invocations by function",
      "type": "timeseries",
      "datasource": { "type": "cloudwatch", "uid": "${CLOUDWATCH_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "namespace": "AWS/Lambda",
          "metricName": "Invocations",
          "statistic": "Sum",
          "dimensions": { "FunctionName": ["studmgmt-get-upload-url", "studmgmt-process-import", "studmgmt-process-submission"] }
        }
      ]
    },
    {
      "title": "Lambda errors by function",
      "type": "timeseries",
      "datasource": { "type": "cloudwatch", "uid": "${CLOUDWATCH_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "statistic": "Sum",
          "dimensions": { "FunctionName": ["studmgmt-get-upload-url", "studmgmt-process-import", "studmgmt-process-submission"] }
        }
      ]
    },
    {
      "title": "Lambda p95 duration by function",
      "type": "timeseries",
      "datasource": { "type": "cloudwatch", "uid": "${CLOUDWATCH_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "namespace": "AWS/Lambda",
          "metricName": "Duration",
          "statistic": "p95",
          "dimensions": { "FunctionName": ["studmgmt-get-upload-url", "studmgmt-process-import", "studmgmt-process-submission"] }
        }
      ]
    },
    {
      "title": "SQS queue depth (all three pipelines)",
      "type": "timeseries",
      "description": "A sustained climb here with flat worker CPU below is the classic 'workers aren't keeping up' signal — see also the resilience test plan's DLQ-redelivery experiment.",
      "datasource": { "type": "cloudwatch", "uid": "${CLOUDWATCH_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "statistic": "Average",
          "dimensions": { "QueueName": ["studmgmt-import-queue", "studmgmt-submission-queue", "studmgmt-audit-archive-queue"] }
        }
      ]
    },
    {
      "title": "Dead-letter queue depth (should stay at zero)",
      "type": "timeseries",
      "description": "Anything above zero here means a message failed 5 times (see maxReceiveCount in each queue's redrive_policy in terraform/) and needs manual investigation — it will not retry further on its own.",
      "datasource": { "type": "cloudwatch", "uid": "${CLOUDWATCH_DATASOURCE_UID}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "statistic": "Average",
          "dimensions": { "QueueName": ["studmgmt-import-dlq", "studmgmt-submission-dlq", "studmgmt-audit-archive-dlq"] }
        }
      ]
    }
  ]
}
